<h1>Form Objects Playground</h1>

<% if @current_user %>
  <p>Signed in as <strong><%= @current_user.name %></strong> (<%= @current_user.email %>) on <strong><%= @current_user.account.name %></strong>.</p>
<% else %>
  <ul>
    <li><%= link_to "Sign up (single page)", new_signup_path %></li>
    <li><%= link_to "Sign up (multi-step wizard)", signup_wizard_path(SignupWizard.steps.first) %></li>
    <li><%= link_to "Sign up (accepts_nested_attributes_for counterpoint)", new_nested_signup_path %></li>
  </ul>
<% end %>
